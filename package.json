{
  "name": "receipt-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "22.17.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @receipt-tracker/web --filter @receipt-tracker/api dev",
    "dev:web": "pnpm --filter @receipt-tracker/web dev",
    "dev:api": "pnpm --filter @receipt-tracker/api dev",
    "dev:worker": "pnpm --filter @receipt-tracker/api dev:worker",
    "start:production": "pnpm --filter @receipt-tracker/api start:production",
    "build": "pnpm --filter @receipt-tracker/contracts build && pnpm --filter @receipt-tracker/web build && pnpm --filter @receipt-tracker/api build",
    "db:generate": "pnpm --filter @receipt-tracker/api db:generate",
    "db:migrate": "pnpm --filter @receipt-tracker/api db:migrate",
    "db:seed": "pnpm --filter @receipt-tracker/api db:seed",
    "test": "pnpm --filter @receipt-tracker/contracts test && pnpm --filter @receipt-tracker/api test",
    "test:integration": "pnpm --filter @receipt-tracker/api test:integration",
    "test:e2e": "volta run --node 22.17.1 -- playwright test",
    "test:e2e:ui": "volta run --node 22.17.1 -- playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
