{
  "name": "receipt-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "22.17.1"
  },
  "scripts": {
    "dev": "pnpm --filter @receipt-tracker/web dev",
