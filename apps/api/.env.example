NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://receipt:receipt@localhost:5432/receipt
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=receipts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123456
S3_FORCE_PATH_STYLE=true

# mock — заглушка для тестов; vision — как в spike (ADR-0015)
EXTRACTOR_KIND=vision
EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1
EXTRACTOR_API_KEY=
# Та же модель, что VISION_MODELS в spike/.env
EXTRACTOR_MODELS=dots-studio/dots-3-note-preview:free
EXTRACTOR_TIMEOUT_MS=120000
EXTRACTOR_MAX_ATTEMPTS=3
EXTRACTOR_DATA_COLLECTION=allow

UPLOAD_MAX_BYTES=15728640
UPLOAD_RATE_PER_HOUR=30

REGISTRATION_ENABLED=true
SENTRY_DSN=
LOG_LEVEL=debug

# Пароль dev-аккаунта из seed (только local)
SEED_DEV_PASSWORD=devpassword12
