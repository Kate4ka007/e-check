{
  "name": "@receipt-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "volta": {
    "node": "22.17.1"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node -e \"require('fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && pnpm --filter @receipt-tracker/contracts build && prisma generate",
    "dev": "volta run --node 22.17.1 -- nest start --watch",
    "dev:worker": "volta run --node 22.17.1 -- tsx src/worker.ts",
    "prebuild": "node -e \"require('fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && prisma generate",
    "build": "nest build",
    "prestart": "pnpm --filter @receipt-tracker/contracts build && nest build",
    "start": "node dist/main.js",
    "start:production": "node scripts/start-production.cjs",
    "worker": "volta run --node 22.17.1 -- node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "volta run --node 22.17.1 -- vitest run",
    "test:integration": "volta run --node 22.17.1 -- vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "reprocess:bad-models": "tsx src/scripts/reprocess-receipts.ts",
    "clear:receipts": "tsx src/scripts/clear-receipts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.2",
    "@receipt-tracker/contracts": "workspace:*",
    "@sentry/node": "^10.12.0",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^5.0.1",
    "openai": "^6.9.0",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
