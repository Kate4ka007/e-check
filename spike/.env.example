# Ключ OpenRouter. Получить на https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Модели-кандидаты через запятую, в порядке приоритета.
# При 404 или 429 скрипт переходит к следующей.
# Актуальный список бесплатных vision-моделей: pnpm models
VISION_MODELS=

# Для двухэтапного варианта: модель, разбирающая уже распознанный текст.
# Можно оставить пустым — тогда вариант two-stage пропускается.
TEXT_MODELS=

# Разрешить провайдерам, которые могут обучаться на запросах.
# allow — пока обрабатываются только свои чеки.
# deny  — перед первым чужим чеком (см. ADR-0012).
DATA_COLLECTION=allow

# Максимальный размер длинной стороны изображения перед отправкой, px.
IMAGE_MAX_SIDE=2000

# Таймаут одного вызова модели, мс
REQUEST_TIMEOUT_MS=120000
